// =============================================================
// LingTai Agent — init.json example
// =============================================================
// Copy this file to your agent's working directory as "init.json"
// and REMOVE all comments (JSON does not allow comments).
//
// Secrets go in a .env file (see env_file below).
// Example .env:
//   OPENAI_API_KEY=your-api-key
//   TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
//   IMAP_PASSWORD=your-email-password
// =============================================================

{
  // Path to .env file for loading secrets as environment variables.
  // Relative to the working directory.
  "env_file": ".env",

  "manifest": {
    // Agent's true name (真名). Set once, never changes.
    // Used for identification in multi-agent networks.
    "agent_name": "my-agent",

    // Language for tool descriptions and system prompt.
    // "en" = English, "zh" = Chinese, "wen" = Classical Chinese (文言文)
    "language": "en",

    // -------------------------------------------------------
    // LLM configuration
    // -------------------------------------------------------
    "llm": {
      // Provider — exactly four families:
      //   "openai"      any OpenAI-compatible endpoint (official OpenAI when
      //                 base_url is omitted; any vendor, gateway, or local
      //                 server via base_url)
      //   "anthropic"   any Anthropic-compatible (Messages API) endpoint
      //                 (official Anthropic when base_url is omitted)
      //   "codex"       Codex / ChatGPT OAuth (one account)
      //   "claude-code" the local Claude Code CLI login
      // Other vendors and subscriptions: point "openai"/"anthropic" at that
      // vendor's compatible base_url, or at an external pool (sub2api /
      // subs-pool). Removed provider names (deepseek, zhipu/glm, mimo,
      // minimax, openrouter, grok, qwen, kimi, gemini, kimi-code, custom,
      // claude_code, codex-pool) fail validation with that pointer.
      "provider": "openai",

      // Model name as recognized by the provider's API.
      "model": "gpt-5.5",

      // API key — set to null and use api_key_env to read from environment (recommended).
      // Never hardcode secrets here.
      "api_key": null,

      // Environment variable name that holds the API key.
      // Resolved at startup from .env or system environment.
      "api_key_env": "OPENAI_API_KEY",

      // Base URL for the provider's API. Set to null (or omit) to use the
      // official endpoint of the chosen family; set it to any compatible
      // endpoint, e.g. "https://api.deepseek.com" or "http://127.0.0.1:8000/v1".
      //
      // "openai" only: "wire_api" selects "chat_completions" (default; the
      // legacy "auto" means the same) or "responses" (always stateless
      // full-history replay; never previous_response_id).
      //
      // Standard parameters (sent verbatim, no per-vendor mapping):
      //   "thinking": none/minimal/low/medium/high/xhigh/max — every
      //     provider. openai sends it as reasoning.effort (Responses) /
      //     reasoning_effort (Chat Completions) and omits it when unset;
      //     codex defaults to xhigh; anthropic maps it to a thinking budget;
      //     claude-code maps it to --effort.
      //   "service_tier": "fast" (sent as priority) or auto/default/flex/
      //     priority — openai and codex only; any other value fails
      //     validation.
      // Retired keys "api_compat", "reasoning_effort_vocab", and
      // "use_responses_api" are ignored.
      // "wire_api": "responses",
      // "thinking": "minimal",
      // "service_tier": "fast",
      "base_url": null
    },

    // -------------------------------------------------------
    // Capabilities — the agent's tool surface
    // -------------------------------------------------------
    // Shape layers (kernel reader contract): new/canonical writes use
    // `manifest.capabilities.shell`. For read-only compatibility, the reader
    // accepts legacy `manifest.capabilities.bash` and maps it in memory to
    // `manifest.capabilities.shell`; the kernel never writes `bash`.
    // If both keys are present, differing values are a conflict (BLOCKED).
    // Equal dual values are compatibility-only; effective memory keeps `shell`.
    //
    // The kernel reader owns this classification; these comments are informative
    // shape guidance, not a migration registry or a runtime history file.
    // The kernel boots the `lingtai.core.*` floor by default on every
    // agent: knowledge, skills, shell, avatar, daemon, and mcp — plus
    // the always-on system, context, pad, lingtai, notification, and email
    // intrinsics.
    // You do NOT need to list those here unless you want to OVERRIDE
    // their default kwargs (e.g. give `shell` a deny-list policy file
    // instead of the default yolo mode).
    //
    // Top-level "disable" (sibling of "capabilities") opts a capability
    // out entirely: e.g. "disable": ["avatar"].
    //
    // Entries below are either:
    //   1. Default-on capabilities (shell shown at its default, skills overridden).
    //   2. Opt-in capabilities not in the default set (vision, web).
    //      web(action='search', input={'query': '...'},
    //          reasoning='discover current sources') discovers; and
    //      web(action='browse', input={'url': '...'},
    //          reasoning='read the selected source') reads a known public page
    //      through one unified capability.
    // -------------------------------------------------------
    "capabilities": {
      // --- Shell access ---
      // Omitted or empty shell config is yolo (no command policy). Explicit
      // "yolo": false uses the packaged policy; an explicit "policy_file"
      // loads that file; "yolo": true takes precedence over both. Example:
      //   "shell": { "policy_file": "bash_policy.json" },
      "shell": {},

      // --- Skills catalog (override) ---
      // `skills` is default-on; this entry adds extra search paths to the
      // prompt catalog. Defaults overlaid:
      //   ../.library_shared       — network-shared skill shelf
      //   ~/.lingtai-tui/utilities — TUI-shipped utility skills
      // Edit and call system.refresh to apply. init.json is ground truth.
      "skills": { "paths": ["../.library_shared", "~/.lingtai-tui/utilities"] },

      // --- Vision (default-on) ---
      // Omitted (or "provider": "inherit"): the agent's own provider family at
      // its effective endpoint and key (openai, anthropic, codex; claude-code
      // gets `claude -p` guidance). Explicit providers: "openai" (+ base_url,
      // api_key_env, model, wire_api), "anthropic" (+ base_url, api_key_env,
      // model), "codex" (+ model, token_path), "local" (OpenAI-compatible
      // local server, no API key), "mlx" (on-device).
      "vision": { "provider": "openai", "api_key_env": "OPENAI_API_KEY", "model": "gpt-5.5" },

      // --- Unified web (default-on) ---
      // No operator config: the built-in default resolver composes the three
      // engines (duckduckgo/openai/anthropic) and selects OpenAI Web Search
      // only when OPENAI_API_KEY is set AND this agent's LLM provider is
      // "openai", else DuckDuckGo. openai/anthropic are backend-gated to an
      // agent whose own provider is that family; Anthropic is explicit opt-in
      // only through the Agent's settings/web.search.json (or
      // LINGTAI_WEB_ENGINE) (see tools/web_search/manual/SKILL.md). Do not
      // name a retired provider (minimax, zhipu) here — it raises a
      // composition-time error; any other unrecognized name (e.g. the removed
      // "gemini") falls back to DuckDuckGo.
      "web": {}

      // --- Removed capabilities (for reference) ---
      // "web_read"        — folded into the `web-manual` skill.
      // "compose"/"video"/"draw"/"talk" — use the `media-creation` skill + an MCP server.
      // "listen"          — use the `listen` skill (faster-whisper + librosa).
    },

    // -------------------------------------------------------
    // Pseudo-agent outbox subscriptions
    // -------------------------------------------------------
    // Paths (relative to this agent's working directory) of pseudo-agent
    // folders whose outbox this agent polls. Pseudo-agents are mailbox-only
    // entities — they have .agent.json but no running process (admin: null),
    // so mail "from" them is written into their own outbox for subscribed
    // real agents to pick up. The default polls the human folder so a
    // human-typed message delivered via the TUI reaches the orchestrator.
    // Polling is mechanical — the agent's LLM never sees this list.
    "pseudo_agent_subscriptions": ["../human"],

    // -------------------------------------------------------
    // Admin privileges
    // -------------------------------------------------------
    // karma: allows lull (sleep other), interrupt, suspend actions.
    // nirvana: allows permanent destruction of other agents.
    // Avatars always get {} (no privileges) regardless of parent.
    "admin": { "karma": true, "nirvana": false },

  },

  // =============================================================
  // Addons — curated MCP server integrations
  // =============================================================
  // Curated addons are MCP servers bundled in the `lingtai` wheel under
  // `lingtai.mcp_servers.*`. The TUI installs that wheel in its local runtime
  // venv and wires the selected addons up in two halves:
  //
  // 1. The `addons:` list below — names of curated MCPs the agent
  //    should "register" on boot. The kernel's `mcp` capability looks
  //    each name up in its catalog and decompresses the record into
  //    <agent>/mcp_registry.jsonl (idempotent, append-only).
  //
  // 2. The `mcp:` activation map below — for each registered MCP,
  //    the subprocess spec (which Python interpreter, which module,
  //    which env vars). Activation is gated by registry membership,
  //    so a name in `mcp:` without a matching `addons:` entry would
  //    be skipped with a warning.
  //
  // Default for new agents (auto-populated by the TUI wizard):
  //
  //   "addons": ["imap", "telegram", "feishu", "wechat", "whatsapp"],
  //   "mcp": {
  //     "imap":     { "type": "stdio", "command": "<venv>/bin/python",
  //                   "args": ["-m", "lingtai.mcp_servers.imap"],
  //                   "env": { "LINGTAI_IMAP_CONFIG": ".secrets/imap.json" } },
  //     "telegram": { ... }, "feishu": { ... }, "wechat": { ... },
  //     "whatsapp": { ... }
  //   }
  //
  // The `command` always points at the local venv Python where the `lingtai`
  // wheel installed its bundled MCP modules — no remote fetch at runtime.
  //
  // Per-MCP secrets live in <agent>/.secrets/<name>.json — plaintext JSON
  // (no *_env indirection in the new MCP shape). Each MCP's README
  // documents the schema; setup skills are available via the agent's
  // library tool. Canonical contract spec: lingtai-kernel-anatomy skill,
  // reference/mcp-protocol.md.

  // =============================================================
  // Agent personality & initial state
  // =============================================================
  // Configurable prompt inputs are Psyche-owned in settings/psyche.json:
  // base_prompt/base_prompt_file and covenant/covenant_file. This optional
  // closed v1 document has four values; it is not an init.json layer.
  // comment/comment_file are retired: remove old keys and use authorized Pad edits.
  // Principle is kernel-owned prompt content and is not configured here.

  // Procedures prompt content is managed by the TUI as system/procedures.md;
  // init.json procedures/procedures_file overrides are no longer honored by the kernel.

  // Initial pad — materialized into system/pad.md. Generic changes are made
  // through shell and take effect in the live prompt only after explicit
  // context.rebuild (or passive refresh/molt reconstruction). pad.append only
  // persists the pinned reference list; it never hot-loads the prompt.
  "pad": ""
  // Or use a file: "pad_file": "pad.md"

  // Character / 灵台 supports two modes. The recommended default is
  // self-evolve: omit `lingtai` (or set it to an empty string), and the
  // agent-authored system/lingtai.md remains the durable self-evolved source and
  // is re-read by explicit context.rebuild and passive refresh/molt reconstruction.
  //
  // Forced identity examples (add a comma after `"pad": ""` above, then
  // uncomment one only when the configured value must be authoritative on
  // every reconstruction):
  // "lingtai": "Describe the agent's configured identity here."
  // "lingtai_file": "lingtai.md"
  // A nonempty resolved value from either form replaces system/lingtai.md
  // during boot, refresh, and post-molt prompt reconstruction. An empty or
  // absent resolved value leaves system/lingtai.md untouched.
}
